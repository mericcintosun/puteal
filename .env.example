# Puteal needs no API keys. Every service it calls is public and keyless.

# Data source behind lib/adapter.ts. "fake" serves the sample village Charpara.
# "real" builds the village from live OpenStreetMap buildings and footpaths through a
# server-side Overpass call, then a saved snapshot, then the sample village if both fail.
# Well test values stay sample data in both modes. Default: fake.
ADAPTER_MODE=fake

# Optional: point the server at another Overpass mirror if the main one is busy.
# Mirrors are listed on the OSM wiki, Public Overpass API instances:
# https://wiki.openstreetmap.org/wiki/Overpass_API#Public_Overpass_API_instances
# Default when unset: https://overpass-api.de/api/interpreter
OVERPASS_URL=

# Public, not a secret, and not set by hand: next.config.ts writes it at build time with
# the names of any uploaded brand images in public/brand (read by lib/brand-files.ts).
# Leave it commented out.
# NEXT_PUBLIC_BRAND_FILES=
